#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ==========================================
# CRITICAL ADDITIONS FOR YOUR PROJECT
# ==========================================

# Environment Variables (For Backend URLs, MapLibre keys, etc.)
.env
.env.*
!.env.example

# Android Specific (Crucial for Android Studio & Firebase)
/android/local.properties       # Contains your local Android SDK path
/android/.gradle/               # Gradle cache
/android/captures/              # Screen recordings/captures
/android/app/google-services.json # Firebase/FCM config

# iOS Specific (Crucial for Firebase & CocoaPods)
/ios/Runner/GoogleService-Info.plist # Firebase/FCM config
/ios/Pods/                      # CocoaPods dependencies
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/xcuserdata/                # Xcode user data